CHATBOT_ENVIRONMENT=development
# MongoDB is the default application store. Use sqlite only for isolated tests.
CHATBOT_DATABASE_BACKEND=mongodb
CHATBOT_MONGODB_URI=mongodb://localhost:27017
CHATBOT_MONGODB_DATABASE=uel_chatbot
# Used only when CHATBOT_DATABASE_BACKEND=sqlite.
CHATBOT_DATABASE_PATH=data/chatbot.sqlite3
CHATBOT_LOG_LEVEL=INFO
CHATBOT_SESSION_TTL_SECONDS=3600
CHATBOT_LOGIN_LIMIT=10
CHATBOT_CHAT_LIMIT=30
CHATBOT_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:5176","http://localhost:5177","http://localhost:5178","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:5175","http://127.0.0.1:5176","http://127.0.0.1:5177","http://127.0.0.1:5178"]
CHATBOT_ALLOWED_HOSTS=["localhost","127.0.0.1","api"]

# Temporary anonymous chat access (development only)
CHATBOT_AUTH_DISABLED=false
